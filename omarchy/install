#!/usr/bin/env bash
# Set up jc's Omarchy config: packages, oh-my-zsh, and symlinks from ./home into $HOME.
# Safe to re-run. Existing files are moved aside as <file>.pre-dotfiles.<timestamp>.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STAMP=$(date +%s)

# 1. Packages
missing=()
for pkg in zsh zsh-autosuggestions zsh-syntax-highlighting voxtype-bin wtype; do
  pacman -Qq "$pkg" &>/dev/null || missing+=("$pkg")
done
if ((${#missing[@]})); then
  echo "Installing: ${missing[*]}"
  omarchy pkg add "${missing[@]}"
fi

# 2. oh-my-zsh
if [[ ! -d ~/.local/share/oh-my-zsh ]]; then
  git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git ~/.local/share/oh-my-zsh
fi

# 3. Symlinks
link() {
  local rel=$1 src="$DIR/home/$1" dest="$HOME/$1"
  mkdir -p "$(dirname "$dest")"
  if [[ -L $dest && $(readlink "$dest") == "$src" ]]; then
    return
  fi
  if [[ -e $dest || -L $dest ]]; then
    mv "$dest" "$dest.pre-dotfiles.$STAMP"
    echo "backed up  ~/$rel"
  fi
  ln -s "$src" "$dest"
  echo "linked     ~/$rel"
}

cd "$DIR/home"
# Files are linked one by one, except Omarchy themes and shell plugins: each
# theme directory is linked whole (omarchy theme set copies themes with cp -r,
# which would copy per-file symlinks as dangling-prone links instead of their
# contents), and so is each plugin, which the shell discovers by directory.
find . \( -path ./.config/omarchy/themes -o -path ./.config/omarchy/plugins \) -prune -o -type f -print | sort | while read -r rel; do
  link "${rel#./}"
done
for dir in .config/omarchy/themes/*/ .config/omarchy/plugins/*/; do
  [[ -d $dir ]] && link "${dir%/}"
done

# 4. Voxtype dictation (config is linked above; model + service + GPU here)
if command -v voxtype &>/dev/null; then
  model=$(sed -n 's/^model *= *"\(.*\)"/\1/p' ~/.config/voxtype/config.toml)
  [[ -f ~/.local/share/voxtype/models/ggml-$model.bin ]] || voxtype setup --download --model "$model" --quiet
  systemctl --user is-enabled voxtype &>/dev/null || voxtype setup systemd >/dev/null
  gpu_status=$(voxtype setup gpu 2>/dev/null || true)
  if omarchy-hw-vulkan && [[ $gpu_status != *"GPU (Vulkan) - active"* ]]; then
    sudo voxtype setup gpu --enable
  fi
  systemctl --user restart voxtype
fi

# 5. Apply
command -v hyprctl &>/dev/null && hyprctl reload >/dev/null && hyprctl configerrors
if [[ $(getent passwd "$USER" | cut -d: -f7) != */zsh ]]; then
  echo
  echo "Make zsh your login shell with:  chsh -s /usr/bin/zsh   (then log out and back in)"
fi
echo "Done. tmux plugins install automatically the first time tmux starts."
