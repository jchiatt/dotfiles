{
  "schemaVersion": 1,
  "id": "jc.daily-word",
  "name": "Daily Word",
  "version": "1.1.0",
  "author": "jc",
  "description": "Daily ESV verse and a quote from Reformed church history",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Daily Word",
    "description": "Cross + today's ESV reference; hover for the verse, click for the verse and a Reformed quote",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "hoverMinWidth": 280
    },
    "schema": [
      {
        "key": "hoverMinWidth",
        "type": "number",
        "label": "Minimum hover card width (px)"
      }
    ]
  }
}
