{
  "schemaVersion": 1,
  "id": "jc.daily-word",
  "name": "Daily Word",
  "version": "1.0.0",
  "author": "jc",
  "description": "Daily ESV verse and a quote from Reformed church history",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Daily Word",
    "description": "Daily ESV verse and a Reformed quote, with a reading popup",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "display": "rotate",
      "rotateSeconds": 60,
      "maxChars": 60
    },
    "schema": [
      { "key": "display", "type": "string", "label": "Bar shows: verse, quote, or rotate" },
      { "key": "rotateSeconds", "type": "number", "label": "Rotate interval (seconds)" },
      { "key": "maxChars", "type": "number", "label": "Max characters in the bar" }
    ]
  }
}
